{
  "name": "@donkor/desktop",
  "version": "1.0.6",
  "private": true,
  "description": "Donkor & Sons desktop app",
  "author": "Donkor Devs <nerdex2000@gmail.com>",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "electron-vite preview",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "package": "electron-vite build && electron-builder --win --x64 --publish=never",
    "release": "electron-vite build && electron-builder --win --x64 --publish=always",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@donkor/db": "workspace:*",
    "@donkor/shared": "workspace:*",
    "@fontsource-variable/fraunces": "^5.0.20",
    "@fontsource-variable/public-sans": "^5.0.18",
    "@fontsource/jetbrains-mono": "^5.0.20",
    "@supabase/auth-js": "^2.105.4",
    "@supabase/functions-js": "^2.105.4",
    "@supabase/postgrest-js": "^2.105.4",
    "@supabase/realtime-js": "^2.105.4",
    "@supabase/storage-js": "^2.105.4",
    "@supabase/supabase-js": "^2.43.0",
    "better-sqlite3": "^11.0.0",
    "date-fns": "^3.6.0",
    "electron-log": "^5.1.2",
    "electron-store": "^9.0.0",
    "electron-updater": "^6.1.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.23.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.43.1",
    "@types/better-sqlite3": "^7.6.10",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.1.0",
    "vite": "^5.2.10",
    "vitest": "^1.5.2"
  }
}
